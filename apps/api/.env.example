PORT=5000
NODE_ENV=development

# Neon PostgreSQL connection string (pooled for runtime queries)
DATABASE_URL=postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/edusync?sslmode=require&pgbouncer=true

# Direct connection string for Prisma migrations
DIRECT_URL=postgresql://user:password@ep-sample.us-east-2.aws.neon.tech/edusync?sslmode=require

# JWT Authentication Secrets
JWT_ACCESS_SECRET=edusync_dev_access_secret_change_in_production_32chars
JWT_REFRESH_SECRET=edusync_dev_refresh_secret_change_in_production_32chars

# Frontend URL for CORS
FRONTEND_URL=http://localhost:3000

# Local File Storage Configuration
UPLOAD_DIR=uploads
MAX_FILE_SIZE=10485760
