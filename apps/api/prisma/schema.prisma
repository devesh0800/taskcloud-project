// Prisma Schema for EduSync - Phase 2
// Database: Neon PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  STUDENT
  TEACHER
  ADMIN
}

enum AssignmentStatus {
  DRAFT
  PUBLISHED
  CLOSED
  ARCHIVED
}

enum SubmissionStatus {
  PENDING
  SUBMITTED
  LATE
  UNDER_REVIEW
  EVALUATED
  RESUBMISSION_REQUIRED
  RESUBMISSION_REQUESTED
}

enum MembershipStatus {
  ACTIVE
  REMOVED
}

model User {
  id            String    @id @default(uuid())
  fullName      String
  email         String    @unique
  passwordHash  String
  role          Role      @default(STUDENT)
  avatarUrl     String?
  isActive      Boolean   @default(true)
  emailVerified Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Teacher specific fields
  teacherId     String?   @unique
  department    String?

  // Student specific fields
  studentId     String?   @unique
  course        String?
  semester      String?
  section       String?

  // Relations
  taughtClasses       Class[]            @relation("TeacherClasses")
  classMemberships    ClassMember[]      @relation("StudentClassMemberships")
  createdAssignments  Assignment[]       @relation("TeacherAssignments")
  submissions         Submission[]       @relation("StudentSubmissions")
  awardedGrades       Grade[]            @relation("TeacherEvaluations")
  notifications       Notification[]
  activityLogs            ActivityLog[]
  refreshTokens           RefreshToken[]
  passwordResetTokens     PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]

  @@index([email])
  @@index([role])
  @@map("users")
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([tokenHash])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([tokenHash])
  @@map("password_reset_tokens")
}

model EmailVerificationToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([tokenHash])
  @@map("email_verification_tokens")
}

model Class {
  id           String        @id @default(uuid())
  name         String
  description  String?
  subject      String?
  department   String?
  semester     String?
  section      String?
  academicYear String?
  classCode    String        @unique
  teacherId    String
  teacher      User          @relation("TeacherClasses", fields: [teacherId], references: [id], onDelete: Restrict)
  isArchived   Boolean       @default(false)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  members      ClassMember[]
  assignments  Assignment[]

  @@index([teacherId])
  @@index([classCode])
  @@index([isArchived])
  @@map("classes")
}

model ClassMember {
  id        String           @id @default(uuid())
  classId   String
  class     Class            @relation(fields: [classId], references: [id], onDelete: Cascade)
  studentId String
  student   User             @relation("StudentClassMemberships", fields: [studentId], references: [id], onDelete: Cascade)
  status    MembershipStatus @default(ACTIVE)
  joinedAt  DateTime         @default(now())
  removedAt DateTime?

  @@unique([classId, studentId])
  @@index([classId])
  @@index([studentId])
  @@index([status])
  @@map("class_members")
}

model Assignment {
  id                  String           @id @default(uuid())
  title               String
  description         String?
  instructions        String           @db.Text
  subject             String?
  totalMarks          Int              @default(100)
  passingMarks        Int?
  startDate           DateTime         @default(now())
  deadline            DateTime
  allowLateSubmission Boolean          @default(true)
  allowResubmission   Boolean          @default(false)
  maxAttempts         Int?             @default(1)
  status              AssignmentStatus @default(DRAFT)
  teacherId           String
  teacher             User             @relation("TeacherAssignments", fields: [teacherId], references: [id], onDelete: Restrict)
  classId             String
  class               Class            @relation(fields: [classId], references: [id], onDelete: Cascade)
  publishedAt         DateTime?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  attachments         AssignmentAttachment[]
  submissions         Submission[]

  @@index([classId])
  @@index([teacherId])
  @@index([status])
  @@index([deadline])
  @@index([classId, status])
  @@map("assignments")
}

model AssignmentAttachment {
  id           String     @id @default(uuid())
  assignmentId String
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  fileName     String
  originalName String
  mimeType     String
  fileSize     Int
  storagePath  String
  createdAt    DateTime   @default(now())

  @@index([assignmentId])
  @@index([fileName])
  @@map("assignment_attachments")
}

model Submission {
  id            String           @id @default(uuid())
  assignmentId  String
  assignment    Assignment       @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  studentId     String
  student       User             @relation("StudentSubmissions", fields: [studentId], references: [id], onDelete: Restrict)
  answerText    String?          @db.Text
  status        SubmissionStatus @default(SUBMITTED)
  attemptNumber Int              @default(1)
  submittedAt   DateTime         @default(now())
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  files         SubmissionFile[]
  attempts      SubmissionAttempt[]
  grades        Grade[]

  @@unique([assignmentId, studentId])
  @@index([assignmentId])
  @@index([studentId])
  @@index([status])
  @@index([studentId, status])
  @@index([assignmentId, status])
  @@map("submissions")
}

model SubmissionAttempt {
  id            String           @id @default(uuid())
  submissionId  String
  submission    Submission       @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  attemptNumber Int
  answerText    String?          @db.Text
  status        SubmissionStatus @default(SUBMITTED)
  submittedAt   DateTime         @default(now())

  files         SubmissionFile[]

  @@index([submissionId])
  @@index([attemptNumber])
  @@map("submission_attempts")
}

model SubmissionFile {
  id           String             @id @default(uuid())
  submissionId String
  submission   Submission         @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  attemptId    String?
  attempt      SubmissionAttempt? @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  fileName     String
  originalName String
  mimeType     String
  fileSize     Int
  storagePath  String
  createdAt    DateTime           @default(now())

  @@index([submissionId])
  @@index([attemptId])
  @@index([fileName])
  @@map("submission_files")
}

model Grade {
  id                 String     @id @default(uuid())
  submissionId       String
  submission         Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  teacherId          String
  teacher            User       @relation("TeacherEvaluations", fields: [teacherId], references: [id], onDelete: Restrict)
  marks              Float
  feedback           String?    @db.Text
  evaluationComments String?    @db.Text
  grade              String?
  isPublished        Boolean    @default(false)
  evaluatedAt        DateTime   @default(now())
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  @@index([submissionId])
  @@index([teacherId])
  @@index([isPublished])
  @@index([submissionId, isPublished])
  @@map("grades")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      String
  entityId  String?
  link      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([isRead])
  @@index([userId, isRead])
  @@map("notifications")
}

model ActivityLog {
  id         String   @id @default(uuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([entityType, entityId])
  @@map("activity_logs")
}
